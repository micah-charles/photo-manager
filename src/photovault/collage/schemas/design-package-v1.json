{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photovault.local/schemas/design-package-v1.json",
  "title": "PhotoManager DesignPackage v1",
  "type": "object",
  "required": ["format", "schema_version", "package_id", "catalog_id", "page_spec", "assets"],
  "properties": {
    "format": {"const": "PhotoManager DesignPackage"},
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^pkg_[a-f0-9]{32}$"},
    "catalog_id": {"type": "string"},
    "page_spec": {"type": "object"},
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "required": ["label", "asset_id", "filename"],
        "properties": {
          "label": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_id": {"type": "string"}, "filename": {"type": "string"}
        }
      }
    }
  }
}
